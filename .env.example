# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
GEOSERVER_PORT=8080

# Postgres / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Front de produção (nginx HTTP/2)
WEB_PORT=8443
# Memória da JVM do GeoServer
GEOSERVER_JAVA_OPTS=-Xms512m -Xmx2g

# API do visualizador (FastAPI)
API_PORT=3000
